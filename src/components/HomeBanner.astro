---
import { Image } from 'astro:assets'
import GitHubActivityCalendar from '~/components/GitHubActivityCalendar.astro'
import type { FrontmatterImage } from '~/types'

interface Props {
  avatarImage?: FrontmatterImage
  githubCalendar?: string
}
const { avatarImage, githubCalendar } = Astro.props
---

<div class="my-8 md:mx-2 relative">
  <div
    class="flex flex-col sm:flex-row items-center justify-around sm:gap-6 max-w-full mb-8 p-6 md:p-8 rounded-xl bg-accent/5 border-2 border-accent/20 shadow-2xl relative overflow-hidden terminal-banner"
  >
    <!-- Animated corner brackets -->
    <div class="absolute top-2 left-2 text-accent/40 font-mono text-xl opacity-50">[</div>
    <div class="absolute top-2 right-2 text-accent/40 font-mono text-xl opacity-50">]</div>
    <div class="absolute bottom-2 left-2 text-accent/40 font-mono text-xl opacity-50">[</div>
    <div class="absolute bottom-2 right-2 text-accent/40 font-mono text-xl opacity-50">]</div>
    
    <!-- Animated gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-br from-accent/10 via-transparent to-accent/10 opacity-60 animate-gradient"></div>
    
    <!-- Scanline effect -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-accent/5 to-transparent h-full animate-scan opacity-50"></div>
    
    {
      avatarImage && (
        <div class="relative z-10 avatar-container">
          <div class="absolute inset-0 rounded-full bg-accent/30 blur-2xl animate-pulse-slow"></div>
          <div class="absolute inset-0 rounded-full border-4 border-accent/40 animate-spin-slow" style="animation-duration: 20s;"></div>
          <Image
            priority
            src={avatarImage.src}
            alt={avatarImage.alt}
            class="relative rounded-full border-8 border-accent/40 size-36 aspect-square box-content shrink-0 shadow-2xl hover:shadow-[0_0_40px_color-mix(in_srgb,var(--theme-accent)_50%,transparent)] transition-all duration-500 hover:scale-110"
            widths={[288]}
            height={144}
            width={144}
          />
        </div>
      )
    }
    <div class="flex-1 relative z-10">
      <div class:list={['m-4 max-w-full prose home-content']}>
        <slot />
      </div>
    </div>
  </div>
  {githubCalendar && <GitHubActivityCalendar username={githubCalendar} />}
</div>

<style>
  .terminal-banner {
    position: relative;
  }
  
  @keyframes animate-gradient {
    0%, 100% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.8;
    }
  }
  
  @keyframes animate-scan {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100%);
    }
  }
  
  @keyframes pulse-slow {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.1);
    }
  }
  
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  
  .avatar-container {
    filter: drop-shadow(0 0 20px color-mix(in srgb, var(--theme-accent) 40%, transparent));
  }
  
  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }
  
  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }
  
  .animate-gradient {
    animation: animate-gradient 4s ease-in-out infinite;
  }
  
  .animate-scan {
    animation: animate-scan 3s linear infinite;
  }
</style>

<style>
  .home-content {
    font-size: 1.125rem;
    line-height: 1.75;
  }
  
  .home-content h1 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  
  @media (min-width: 768px) {
    .home-content h1 {
      font-size: 2.25rem;
    }
  }
  
  .home-content p {
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  
  @media (min-width: 768px) {
    .home-content p {
      font-size: 1.125rem;
    }
  }
  
  .home-content ul {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  
  .home-content ul li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  
  .home-content li {
    font-size: 1rem;
  }
  
  @media (min-width: 768px) {
    .home-content li {
      font-size: 1.125rem;
    }
  }
  
  .home-content blockquote {
    font-size: 1.125rem;
    font-style: italic;
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 768px) {
    .home-content blockquote {
      font-size: 1.25rem;
    }
  }
</style>

