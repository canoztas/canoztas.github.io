---
import { Image } from 'astro:assets'
import GitHubActivityCalendar from '~/components/GitHubActivityCalendar.astro'
import type { FrontmatterImage } from '~/types'

interface Props {
  avatarImage?: FrontmatterImage
  githubCalendar?: string
}
const { avatarImage, githubCalendar } = Astro.props
---

<div class="my-8 md:mx-2">
  <div
    class="flex flex-col sm:flex-row items-center justify-around sm:gap-6 max-w-full mb-8 p-4 rounded-xl bg-accent/5 border border-accent/10"
  >
    {
      avatarImage && (
        <Image
          priority
          src={avatarImage.src}
          alt={avatarImage.alt}
          class="rounded-full border-8 border-accent/20 size-36 aspect-square box-content shrink-0 shadow-lg hover:shadow-xl transition-shadow duration-300"
          widths={[288]}
          height={144}
          width={144}
        />
      )
    }
    <div class="flex-1">
      <div class:list={['m-4 max-w-full prose home-content']}>
        <slot />
      </div>
    </div>
  </div>
  {githubCalendar && <GitHubActivityCalendar username={githubCalendar} />}
</div>

<style>
  .home-content {
    font-size: 1.125rem;
    line-height: 1.75;
  }
  
  .home-content h1 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  
  @media (min-width: 768px) {
    .home-content h1 {
      font-size: 2.25rem;
    }
  }
  
  .home-content p {
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  
  @media (min-width: 768px) {
    .home-content p {
      font-size: 1.125rem;
    }
  }
  
  .home-content ul {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  
  .home-content ul li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  
  .home-content li {
    font-size: 1rem;
  }
  
  @media (min-width: 768px) {
    .home-content li {
      font-size: 1.125rem;
    }
  }
  
  .home-content blockquote {
    font-size: 1.125rem;
    font-style: italic;
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 768px) {
    .home-content blockquote {
      font-size: 1.25rem;
    }
  }
</style>

